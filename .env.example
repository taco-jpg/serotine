# D1 is provided by the serotine_db binding in wrangler.toml.
# No .env secrets are required for local development.
# Run npm run db:migrate:local before npm run dev.
# Configure production resources and secrets through Wrangler/Cloudflare.

# Optional public GIPHY app key for GIF search and inline GIPHY viewing.
# Create your own key at https://developers.giphy.com/dashboard/.
# For local development, set this in .env.local. For Cloudflare, set the same
# public key as a Worker variable/secret; the browser loads it from /api/giphy/config.
# A BUILD environment value also works, but requires a rebuild after changes.
# This is intentionally public to the browser, not a private server credential.
NEXT_PUBLIC_GIPHY_API_KEY=

# Live calling: configure these as Worker secrets, never NEXT_PUBLIC variables.
# For local workerd only, place them in the ignored .dev.vars file.
# CALL_TURN_KEY_ID=<TURN key uid from Cloudflare Realtime TURN>
# CALL_TURN_API_TOKEN=<that TURN key's server-side bearer token, not your account API token>
# Optional Worker variable: comma-separated STUN URLs.
# CALL_STUN_URLS=stun:stun.cloudflare.com:3478
