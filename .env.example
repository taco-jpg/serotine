# D1 is provided by the serotine_db binding in wrangler.toml.
# No .env secrets are required for local development.
# Run npm run db:migrate:local before npm run dev.
# Configure production resources and secrets through Wrangler/Cloudflare.

# Optional public GIPHY app key for GIF search and inline GIPHY viewing.
# Create your own key at https://developers.giphy.com/dashboard/.
# Set this in the BUILD environment before building/deploying; rebuild after changes.
# This is intentionally public in the client bundle, not a private server secret.
NEXT_PUBLIC_GIPHY_API_KEY=
